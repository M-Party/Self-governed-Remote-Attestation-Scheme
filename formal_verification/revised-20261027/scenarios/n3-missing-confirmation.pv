(* SRAS revision 20261027; N=3; kind=regression; scenario=missing-confirmation.
 * SINGLE static initialization with exactly N protected RPE roles.
 * The adversary chooses the last owner's policy from 11 documented profiles.
 * All network sends/receives are public and adversary-controlled.
 * This file is generated by generate_models.py; original models remain intact.
 *)
(* Shared policy algebra for the revised SRAS models, ProVerif 2.05.
 * Exact identity attributes are symbolic atoms. SVN and TCB are finite.
 * Joins return only normalized constraints; no source-policy history is kept.
 * A failed destructor represents an unsatisfiable/ill-formed component.
 *)

type party.
type attr.
type ident.
type svn.
type tcbstatus.
type tcbreq.
type attreq.
type entry.
type identity.

const P1: party [data].
const P2: party [data].
const P3: party [data].
const mRPE: attr [data].
const mE1: attr [data].
const mE2: attr [data].
const mE3: attr [data].
const mBad: attr [data].
const s1: attr [data].
const s2: attr [data].
const s3: attr [data].
const sBad: attr [data].
const prodA: attr [data].
const prodB: attr [data].

const Any: ident [data].
fun exact(attr): ident [data].

(* V0 is both the least represented version and the unrestricted lower bound.
 * The represented order is V0 < V1 < V2; unbounded integer SVN is not modeled.
 *)
const V0: svn [data].
const V1: svn [data].
const V2: svn [data].

const Good: tcbstatus [data].
const Outdated: tcbstatus [data].
const Revoked: tcbstatus [data].
const Invalid: tcbstatus [data].
const Both: tcbreq [data].
const OnlyGood: tcbreq [data].
const OnlyOutdated: tcbreq [data].

const NoAtt: attreq [data].
fun Assign(party): attreq [data].

(* Canonical order: measurement, signer, product, minimum SVN, TCB, attester. *)
fun Req(ident, ident, ident, svn, tcbreq, attreq): entry [data].
fun Identity(attr, attr, attr, svn): identity [data].

(* Shape-aware rules reject arbitrary names of type ident/attreq rather than
 * returning them unchanged through a wildcard rule. Exact atoms are symbolic.
 *)
fun joinid(ident, ident): ident
reduc joinid(Any, Any) = Any
otherwise forall a: attr; joinid(Any, exact(a)) = exact(a)
otherwise forall a: attr; joinid(exact(a), Any) = exact(a)
otherwise forall a: attr; joinid(exact(a), exact(a)) = exact(a).

fun joinv(svn, svn): svn
reduc joinv(V0, V0) = V0
otherwise joinv(V0, V1) = V1
otherwise joinv(V0, V2) = V2
otherwise joinv(V1, V0) = V1
otherwise joinv(V1, V1) = V1
otherwise joinv(V1, V2) = V2
otherwise joinv(V2, V0) = V2
otherwise joinv(V2, V1) = V2
otherwise joinv(V2, V2) = V2.

(* Intersection of nonempty acceptable-status sets. The disjoint pair
 * OnlyGood/OnlyOutdated has no rule and therefore aborts the local join.
 *)
fun jointcb(tcbreq, tcbreq): tcbreq
reduc jointcb(Both, Both) = Both
otherwise jointcb(Both, OnlyGood) = OnlyGood
otherwise jointcb(Both, OnlyOutdated) = OnlyOutdated
otherwise jointcb(OnlyGood, Both) = OnlyGood
otherwise jointcb(OnlyOutdated, Both) = OnlyOutdated
otherwise jointcb(OnlyGood, OnlyGood) = OnlyGood
otherwise jointcb(OnlyOutdated, OnlyOutdated) = OnlyOutdated.

fun joinatt(attreq, attreq): attreq
reduc joinatt(NoAtt, NoAtt) = NoAtt
otherwise forall a: party; joinatt(NoAtt, Assign(a)) = Assign(a)
otherwise forall a: party; joinatt(Assign(a), NoAtt) = Assign(a)
otherwise forall a: party; joinatt(Assign(a), Assign(a)) = Assign(a).

(* Satisfaction destructors return true only for accepted values. *)
fun matchid(ident, attr): bool
reduc forall a: attr; matchid(Any, a) = true
otherwise forall a: attr; matchid(exact(a), a) = true.

fun matchv(svn, svn): bool
reduc matchv(V0, V0) = true
otherwise matchv(V0, V1) = true
otherwise matchv(V0, V2) = true
otherwise matchv(V1, V1) = true
otherwise matchv(V1, V2) = true
otherwise matchv(V2, V2) = true.

fun matchtcb(tcbreq, tcbstatus): bool
reduc matchtcb(Both, Good) = true
otherwise matchtcb(Both, Outdated) = true
otherwise matchtcb(OnlyGood, Good) = true
otherwise matchtcb(OnlyOutdated, Outdated) = true.

(* NoAtt contributes no assignment; it never authorizes an arbitrary RPE. *)
fun matchatt(attreq, party): bool
reduc forall a: party; matchatt(Assign(a), a) = true.

(* Initialization checks for adversary-selected policy components. *)
fun validid(ident): bool
reduc validid(Any) = true
otherwise forall a: attr; validid(exact(a)) = true.

fun validv(svn): bool
reduc validv(V0) = true
otherwise validv(V1) = true
otherwise validv(V2) = true.

fun validtcbreq(tcbreq): bool
reduc validtcbreq(Both) = true
otherwise validtcbreq(OnlyGood) = true
otherwise validtcbreq(OnlyOutdated) = true.

fun validatt(attreq): bool
reduc validatt(NoAtt) = true
otherwise forall a: party; validatt(Assign(a)) = true.

letfun validentry(c: entry) =
  let Req(cm: ident, cs: ident, cp: ident, cv: svn, ct: tcbreq, ca: attreq) = c in
  let vm = validid(cm) in
  let vs = validid(cs) in
  let vp = validid(cp) in
  let vv = validv(cv) in
  let vt = validtcbreq(ct) in
  let va = validatt(ca) in
  vm && vs && vp && vv && vt && va.

letfun joinentry(x: entry, y: entry) =
  let Req(xm: ident, xs: ident, xp: ident, xv: svn, xt: tcbreq, xa: attreq) = x in
  let Req(ym: ident, ys: ident, yp: ident, yv: svn, yt: tcbreq, ya: attreq) = y in
  let jm = joinid(xm, ym) in
  let js = joinid(xs, ys) in
  let jp = joinid(xp, yp) in
  let jv = joinv(xv, yv) in
  let jt = jointcb(xt, yt) in
  let ja = joinatt(xa, ya) in
  Req(jm, js, jp, jv, jt, ja).

letfun checkentry(c: entry, who: party, actual: identity, ts: tcbstatus) =
  let Req(cm: ident, cs: ident, cp: ident, cv: svn, ct: tcbreq, ca: attreq) = c in
  let Identity(am: attr, asigner: attr, ap: attr, av: svn) = actual in
  let vm = matchid(cm, am) in
  let vs = matchid(cs, asigner) in
  let vp = matchid(cp, ap) in
  let vv = matchv(cv, av) in
  let vt = matchtcb(ct, ts) in
  let va = matchatt(ca, who) in
  vm && vs && vp && vv && vt && va.

type policy.
type polstar.
type roster.
type profile.
type entity.
type nonce.
type pkey.
type skey.
free net: channel.
free E1, E2, E3: entity.
const Members3: roster [data].
free badHash: bitstring.
fun pol(party, roster, tcbreq, tcbreq, tcbreq, entry, entry, entry): policy [data].
(* mkstar now stores only normalized joined constraints, NOT source policies. *)
fun mkstar(tcbreq, tcbreq, tcbreq, entry, entry, entry): polstar [data].
reduc forall a: party, members: roster, t1: tcbreq, t2: tcbreq, t3: tcbreq, e1: entry, e2: entry, e3: entry;
  policySelf(pol(a, members, t1, t2, t3, e1, e2, e3)) = a.
reduc forall a: party, members: roster, t1: tcbreq, t2: tcbreq, t3: tcbreq, e1: entry, e2: entry, e3: entry;
  constraints(pol(a, members, t1, t2, t3, e1, e2, e3)) = mkstar(t1, t2, t3, e1, e2, e3).
reduc forall a: party, members: roster, t1: tcbreq, t2: tcbreq, t3: tcbreq, e1: entry, e2: entry, e3: entry;
  rpeTcb1(pol(a, members, t1, t2, t3, e1, e2, e3)) = t1.
reduc forall t1: tcbreq, t2: tcbreq, t3: tcbreq, e1: entry, e2: entry, e3: entry;
  starEntry1(mkstar(t1, t2, t3, e1, e2, e3)) = e1.
reduc forall a: party, members: roster, t1: tcbreq, t2: tcbreq, t3: tcbreq, e1: entry, e2: entry, e3: entry;
  rpeTcb2(pol(a, members, t1, t2, t3, e1, e2, e3)) = t2.
reduc forall t1: tcbreq, t2: tcbreq, t3: tcbreq, e1: entry, e2: entry, e3: entry;
  starEntry2(mkstar(t1, t2, t3, e1, e2, e3)) = e2.
reduc forall a: party, members: roster, t1: tcbreq, t2: tcbreq, t3: tcbreq, e1: entry, e2: entry, e3: entry;
  rpeTcb3(pol(a, members, t1, t2, t3, e1, e2, e3)) = t3.
reduc forall t1: tcbreq, t2: tcbreq, t3: tcbreq, e1: entry, e2: entry, e3: entry;
  starEntry3(mkstar(t1, t2, t3, e1, e2, e3)) = e3.

(* Exact finite-domain specialization of the componentwise join.
 * Conflicting tuples have no rule. No input history enters mkstar.
 * Generic scalar/entry semantics are checked in join-regression.pv. *)
fun joinstar(polstar, polstar): polstar
reduc joinstar(mkstar(OnlyGood,OnlyGood,OnlyGood,Req(exact(mE1),exact(s1),exact(prodA),V1,OnlyGood,Assign(P1)),Req(exact(mE2),exact(s2),exact(prodA),V1,OnlyGood,Assign(P2)),Req(exact(mE3),exact(s3),exact(prodA),V1,OnlyGood,Assign(P3))), mkstar(Both,Both,Both,Req(Any,Any,Any,V0,Both,NoAtt),Req(Any,Any,Any,V0,Both,NoAtt),Req(Any,exact(s3),Any,V0,Both,Assign(P3)))) = mkstar(OnlyGood,OnlyGood,OnlyGood,Req(exact(mE1),exact(s1),exact(prodA),V1,OnlyGood,Assign(P1)),Req(exact(mE2),exact(s2),exact(prodA),V1,OnlyGood,Assign(P2)),Req(exact(mE3),exact(s3),exact(prodA),V1,OnlyGood,Assign(P3)))
otherwise joinstar(mkstar(OnlyGood,OnlyGood,OnlyGood,Req(exact(mE1),exact(s1),exact(prodA),V1,OnlyGood,Assign(P1)),Req(exact(mE2),exact(s2),exact(prodA),V1,OnlyGood,Assign(P2)),Req(exact(mE3),exact(s3),exact(prodA),V1,OnlyGood,Assign(P3))), mkstar(Both,Both,Both,Req(exact(mE1),exact(s1),exact(prodA),V1,OnlyGood,Assign(P1)),Req(exact(mE2),exact(s2),exact(prodA),V1,OnlyGood,Assign(P2)),Req(exact(mE3),exact(s3),exact(prodA),V1,OnlyGood,Assign(P3)))) = mkstar(OnlyGood,OnlyGood,OnlyGood,Req(exact(mE1),exact(s1),exact(prodA),V1,OnlyGood,Assign(P1)),Req(exact(mE2),exact(s2),exact(prodA),V1,OnlyGood,Assign(P2)),Req(exact(mE3),exact(s3),exact(prodA),V1,OnlyGood,Assign(P3)))
otherwise joinstar(mkstar(OnlyGood,OnlyGood,OnlyGood,Req(exact(mE1),exact(s1),exact(prodA),V1,OnlyGood,Assign(P1)),Req(exact(mE2),exact(s2),exact(prodA),V1,OnlyGood,Assign(P2)),Req(exact(mE3),exact(s3),exact(prodA),V1,OnlyGood,Assign(P3))), mkstar(OnlyGood,OnlyGood,OnlyGood,Req(exact(mE1),exact(s1),exact(prodA),V1,OnlyGood,Assign(P1)),Req(exact(mE2),exact(s2),exact(prodA),V1,OnlyGood,Assign(P2)),Req(exact(mE3),exact(s3),exact(prodA),V1,OnlyGood,Assign(P3)))) = mkstar(OnlyGood,OnlyGood,OnlyGood,Req(exact(mE1),exact(s1),exact(prodA),V1,OnlyGood,Assign(P1)),Req(exact(mE2),exact(s2),exact(prodA),V1,OnlyGood,Assign(P2)),Req(exact(mE3),exact(s3),exact(prodA),V1,OnlyGood,Assign(P3)))
otherwise joinstar(mkstar(OnlyGood,OnlyGood,OnlyGood,Req(exact(mE1),exact(s1),exact(prodA),V1,OnlyGood,Assign(P1)),Req(exact(mE2),exact(s2),exact(prodA),V1,OnlyGood,Assign(P2)),Req(exact(mE3),exact(s3),exact(prodA),V1,OnlyGood,Assign(P3))), mkstar(OnlyGood,OnlyGood,OnlyGood,Req(exact(mE1),exact(s1),exact(prodA),V1,OnlyGood,NoAtt),Req(exact(mE2),exact(s2),exact(prodA),V1,OnlyGood,NoAtt),Req(exact(mE3),exact(s3),exact(prodA),V1,OnlyGood,Assign(P3)))) = mkstar(OnlyGood,OnlyGood,OnlyGood,Req(exact(mE1),exact(s1),exact(prodA),V1,OnlyGood,Assign(P1)),Req(exact(mE2),exact(s2),exact(prodA),V1,OnlyGood,Assign(P2)),Req(exact(mE3),exact(s3),exact(prodA),V1,OnlyGood,Assign(P3)))
otherwise joinstar(mkstar(OnlyGood,OnlyGood,OnlyGood,Req(exact(mE1),exact(s1),exact(prodA),V1,OnlyGood,Assign(P1)),Req(exact(mE2),exact(s2),exact(prodA),V1,OnlyGood,Assign(P2)),Req(exact(mE3),exact(s3),exact(prodA),V1,OnlyGood,Assign(P3))), mkstar(OnlyGood,OnlyGood,OnlyGood,Req(exact(mE1),exact(s1),exact(prodA),V2,OnlyGood,Assign(P1)),Req(exact(mE2),exact(s2),exact(prodA),V1,OnlyGood,Assign(P2)),Req(exact(mE3),exact(s3),exact(prodA),V1,OnlyGood,Assign(P3)))) = mkstar(OnlyGood,OnlyGood,OnlyGood,Req(exact(mE1),exact(s1),exact(prodA),V2,OnlyGood,Assign(P1)),Req(exact(mE2),exact(s2),exact(prodA),V1,OnlyGood,Assign(P2)),Req(exact(mE3),exact(s3),exact(prodA),V1,OnlyGood,Assign(P3))).
const Compatible: profile [data].
const Weak: profile [data].
const StrongerSVN: profile [data].
const ConflictMeasurement: profile [data].
const ConflictSigner: profile [data].
const ConflictProduct: profile [data].
const ConflictTCB: profile [data].
const ConflictAttester: profile [data].
const RejectPeerTCB: profile [data].
const NoAssignments: profile [data].
const PermissiveRpeTCB: profile [data].

(* Explicit finite policy domain for the adversarial owner; see policy-catalog.json. *)
fun choosePolicy(profile): policy
reduc choosePolicy(Compatible) = pol(P3, Members3, OnlyGood, OnlyGood, OnlyGood, Req(exact(mE1), exact(s1), exact(prodA), V1, OnlyGood, Assign(P1)), Req(exact(mE2), exact(s2), exact(prodA), V1, OnlyGood, Assign(P2)), Req(exact(mE3), exact(s3), exact(prodA), V1, OnlyGood, Assign(P3)))
otherwise choosePolicy(Weak) = pol(P3, Members3, Both, Both, Both, Req(Any, Any, Any, V0, Both, NoAtt), Req(Any, Any, Any, V0, Both, NoAtt), Req(Any, exact(s3), Any, V0, Both, Assign(P3)))
otherwise choosePolicy(StrongerSVN) = pol(P3, Members3, OnlyGood, OnlyGood, OnlyGood, Req(exact(mE1), exact(s1), exact(prodA), V2, OnlyGood, Assign(P1)), Req(exact(mE2), exact(s2), exact(prodA), V1, OnlyGood, Assign(P2)), Req(exact(mE3), exact(s3), exact(prodA), V1, OnlyGood, Assign(P3)))
otherwise choosePolicy(ConflictMeasurement) = pol(P3, Members3, OnlyGood, OnlyGood, OnlyGood, Req(exact(mBad), exact(s1), exact(prodA), V1, OnlyGood, Assign(P1)), Req(exact(mE2), exact(s2), exact(prodA), V1, OnlyGood, Assign(P2)), Req(exact(mE3), exact(s3), exact(prodA), V1, OnlyGood, Assign(P3)))
otherwise choosePolicy(ConflictSigner) = pol(P3, Members3, OnlyGood, OnlyGood, OnlyGood, Req(exact(mE1), exact(sBad), exact(prodA), V1, OnlyGood, Assign(P1)), Req(exact(mE2), exact(s2), exact(prodA), V1, OnlyGood, Assign(P2)), Req(exact(mE3), exact(s3), exact(prodA), V1, OnlyGood, Assign(P3)))
otherwise choosePolicy(ConflictProduct) = pol(P3, Members3, OnlyGood, OnlyGood, OnlyGood, Req(exact(mE1), exact(s1), exact(prodB), V1, OnlyGood, Assign(P1)), Req(exact(mE2), exact(s2), exact(prodA), V1, OnlyGood, Assign(P2)), Req(exact(mE3), exact(s3), exact(prodA), V1, OnlyGood, Assign(P3)))
otherwise choosePolicy(ConflictTCB) = pol(P3, Members3, OnlyGood, OnlyGood, OnlyGood, Req(exact(mE1), exact(s1), exact(prodA), V1, OnlyOutdated, Assign(P1)), Req(exact(mE2), exact(s2), exact(prodA), V1, OnlyGood, Assign(P2)), Req(exact(mE3), exact(s3), exact(prodA), V1, OnlyGood, Assign(P3)))
otherwise choosePolicy(ConflictAttester) = pol(P3, Members3, OnlyGood, OnlyGood, OnlyGood, Req(exact(mE1), exact(s1), exact(prodA), V1, OnlyGood, Assign(P3)), Req(exact(mE2), exact(s2), exact(prodA), V1, OnlyGood, Assign(P2)), Req(exact(mE3), exact(s3), exact(prodA), V1, OnlyGood, Assign(P3)))
otherwise choosePolicy(RejectPeerTCB) = pol(P3, Members3, OnlyOutdated, OnlyGood, OnlyGood, Req(exact(mE1), exact(s1), exact(prodA), V1, OnlyGood, Assign(P1)), Req(exact(mE2), exact(s2), exact(prodA), V1, OnlyGood, Assign(P2)), Req(exact(mE3), exact(s3), exact(prodA), V1, OnlyGood, Assign(P3)))
otherwise choosePolicy(NoAssignments) = pol(P3, Members3, OnlyGood, OnlyGood, OnlyGood, Req(exact(mE1), exact(s1), exact(prodA), V1, OnlyGood, NoAtt), Req(exact(mE2), exact(s2), exact(prodA), V1, OnlyGood, NoAtt), Req(exact(mE3), exact(s3), exact(prodA), V1, OnlyGood, Assign(P3)))
otherwise choosePolicy(PermissiveRpeTCB) = pol(P3, Members3, Both, Both, Both, Req(exact(mE1), exact(s1), exact(prodA), V1, OnlyGood, Assign(P1)), Req(exact(mE2), exact(s2), exact(prodA), V1, OnlyGood, Assign(P2)), Req(exact(mE3), exact(s3), exact(prodA), V1, OnlyGood, Assign(P3))).

(* Perfect signatures/hashes. All communication remains on public net.
 * Receiver-key arguments encode authentication-channel endpoint association,
 * not new SRAS fields, a new round, or a session identifier.
 * Confidentiality/TLS internals are deliberately not proved by this model.
 *)
fun pk(skey): pkey.
fun sign(bitstring, skey): bitstring.
reduc forall m: bitstring, k: skey; getmess(sign(m,k)) = m.
reduc forall m: bitstring, k: skey; checksign(sign(m,k), pk(k)) = m.
fun hpol(policy): bitstring.
fun hbind(pkey, bitstring): bitstring.
fun hstar(polstar): bitstring.
fun hchal(nonce, pkey): bitstring.
fun hcert(pkey, pkey, bitstring): bitstring.
fun rpeQuote(attr, tcbstatus, bitstring): bitstring [data].
fun teeQuote(identity, tcbstatus, bitstring): bitstring [data].
fun policyMsg(pkey, policy): bitstring [data].
fun confirmMsg(pkey, bitstring): bitstring [data].

event PolicyDeclared(party, policy).
(* EvidenceChecked labels a collection slot, not authenticated policy Self. *)
event EvidenceChecked(party, party, pkey, bitstring).
event QuotesComplete(party).
event PolicySent(party, pkey, policy).
event PolicyAuthenticated(party, party, policy).
event PolicyAccepted(party, party, policy).
event PolicyAcceptedKeys(party, party, pkey, pkey, policy).
event PoliciesComplete(party).
event FullJoin(party, polstar).
event ConfirmationSent(party, party, bitstring).
event ConfirmationAuthenticated(party, party, bitstring).
event ConfirmationAccepted(party, party, bitstring).
event Confirm(party, polstar).
event QuoteProduced(pkey, nonce, identity, tcbstatus).
event ChallengeSent(party, pkey, nonce).
event QuoteReceived(party, entity, pkey, nonce).
event QuoteSignatureChecked(party, entity, pkey, nonce, identity, tcbstatus).
event QuoteVerified(party, entity, pkey, nonce, identity, tcbstatus).
event QuoteSatisfied(party, entity, pkey, pkey, nonce, identity, tcbstatus, polstar).
event CertIssued(party, entity, pkey, pkey, nonce, identity, tcbstatus, polstar, bitstring).
query x: polstar; event(FullJoin(P1,x)).
query x: polstar; event(Confirm(P1,x)).

(* RPE_1: required peers are the fixed Members3 configuration minus self. *)
let rpe1(akR: skey, pkAKR: pkey, pkAKE: pkey) =
  let rho1 = pol(P1, Members3, OnlyGood, OnlyGood, OnlyGood, Req(exact(mE1), exact(s1), exact(prodA), V1, OnlyGood, Assign(P1)), Req(exact(mE2), exact(s2), exact(prodA), V1, OnlyGood, Assign(P2)), Req(exact(mE3), exact(s3), exact(prodA), V1, OnlyGood, Assign(P3))) in
  (* Stage 1 is an initialization premise: Self=P1, authorized policy/key,
   * concrete own signer s1; owner signature verification is not proved here. *)
  new sk1: skey;
  let pk1 = pk(sk1) in
  event PolicyDeclared(P1,rho1);
  let q1 = sign(rpeQuote(mRPE,Good,hbind(pk1,hpol(rho1))),akR) in
  out(net,(P1,q1,pk1,hpol(rho1)));
  in(net,(=P2,q2: bitstring,pk2: pkey,hb2: bitstring));
  let rpeQuote(=mRPE,ts2: tcbstatus,d2: bitstring) = checksign(q2,pkAKR) in
  if d2 = hbind(pk2,hb2) then
  let tcbok2 = matchtcb(rpeTcb2(rho1),ts2) in
  if tcbok2 = true then
  if pk2 <> pk1 then
  event EvidenceChecked(P1,P2,pk2,hb2);
  in(net,(=P3,q3: bitstring,pk3: pkey,hb3: bitstring));
  let rpeQuote(=mRPE,ts3: tcbstatus,d3: bitstring) = checksign(q3,pkAKR) in
  if d3 = hbind(pk3,hb3) then
  let tcbok3 = matchtcb(rpeTcb3(rho1),ts3) in
  if tcbok3 = true then
  if pk3 <> pk1 && pk3 <> pk2 then
  event EvidenceChecked(P1,P3,pk3,hb3);
  event QuotesComplete(P1);
  event PolicySent(P1,pk2,rho1);
  out(net,(P1,P2,sign(policyMsg(pk2,rho1),sk1)));
  event PolicySent(P1,pk3,rho1);
  out(net,(P1,P3,sign(policyMsg(pk3,rho1),sk1)));
  in(net,(=P2,=P1,msg2: bitstring));
  let policyMsg(=pk1,rho2: policy) = checksign(msg2,pk2) in
  event PolicyAuthenticated(P1,P2,rho2);
  if hpol(rho2) = hb2 then
  if policySelf(rho2) = P2 then
  event PolicyAccepted(P1,P2,rho2);
  event PolicyAcceptedKeys(P1,P2,pk1,pk2,rho2);
  in(net,(=P3,=P1,msg3: bitstring));
  let policyMsg(=pk1,rho3: policy) = checksign(msg3,pk3) in
  event PolicyAuthenticated(P1,P3,rho3);
  if hpol(rho3) = hb3 then
  if policySelf(rho3) = P3 then
  event PolicyAccepted(P1,P3,rho3);
  event PolicyAcceptedKeys(P1,P3,pk1,pk3,rho3);
  event PoliciesComplete(P1);
  let joined12 = joinstar(constraints(rho1),constraints(rho2)) in
  let pistar = joinstar(joined12,constraints(rho3)) in
  event FullJoin(P1,pistar);
  event ConfirmationSent(P1,P2,hstar(pistar));
  out(net,(P1,P2,sign(confirmMsg(pk2,hstar(pistar)),sk1)));
  event ConfirmationSent(P1,P3,hstar(pistar));
  out(net,(P1,P3,sign(confirmMsg(pk3,hstar(pistar)),sk1)));
  in(net,(=P2,=P1,confirmation2: bitstring));
  let confirmMsg(=pk1,hs2: bitstring) = checksign(confirmation2,pk2) in
  event ConfirmationAuthenticated(P1,P2,hs2);
  if hs2 = hstar(pistar) then
  event ConfirmationAccepted(P1,P2,hs2);
  in(net,(=P3,=P1,confirmation3: bitstring));
  let confirmMsg(=pk1,hs3: bitstring) = checksign(confirmation3,pk3) in
  event ConfirmationAuthenticated(P1,P3,hs3);
  if hs3 = hstar(pistar) then
  event ConfirmationAccepted(P1,P3,hs3);
  event Confirm(P1,pistar).

(* RPE_2: required peers are the fixed Members3 configuration minus self. *)
let rpe2(akR: skey, pkAKR: pkey, pkAKE: pkey) =
  let rho2 = pol(P2, Members3, OnlyGood, OnlyGood, OnlyGood, Req(exact(mE1), exact(s1), exact(prodA), V1, OnlyGood, Assign(P1)), Req(exact(mE2), exact(s2), exact(prodA), V1, OnlyGood, Assign(P2)), Req(exact(mE3), exact(s3), exact(prodA), V1, OnlyGood, Assign(P3))) in
  (* Stage 1 is an initialization premise: Self=P2, authorized policy/key,
   * concrete own signer s2; owner signature verification is not proved here. *)
  new sk2: skey;
  let pk2 = pk(sk2) in
  event PolicyDeclared(P2,rho2);
  let q2 = sign(rpeQuote(mRPE,Good,hbind(pk2,hpol(rho2))),akR) in
  out(net,(P2,q2,pk2,hpol(rho2)));
  in(net,(=P1,q1: bitstring,pk1: pkey,hb1: bitstring));
  let rpeQuote(=mRPE,ts1: tcbstatus,d1: bitstring) = checksign(q1,pkAKR) in
  if d1 = hbind(pk1,hb1) then
  let tcbok1 = matchtcb(rpeTcb1(rho2),ts1) in
  if tcbok1 = true then
  if pk1 <> pk2 then
  event EvidenceChecked(P2,P1,pk1,hb1);
  in(net,(=P3,q3: bitstring,pk3: pkey,hb3: bitstring));
  let rpeQuote(=mRPE,ts3: tcbstatus,d3: bitstring) = checksign(q3,pkAKR) in
  if d3 = hbind(pk3,hb3) then
  let tcbok3 = matchtcb(rpeTcb3(rho2),ts3) in
  if tcbok3 = true then
  if pk3 <> pk2 && pk3 <> pk1 then
  event EvidenceChecked(P2,P3,pk3,hb3);
  event QuotesComplete(P2);
  event PolicySent(P2,pk1,rho2);
  out(net,(P2,P1,sign(policyMsg(pk1,rho2),sk2)));
  event PolicySent(P2,pk3,rho2);
  out(net,(P2,P3,sign(policyMsg(pk3,rho2),sk2)));
  in(net,(=P1,=P2,msg1: bitstring));
  let policyMsg(=pk2,rho1: policy) = checksign(msg1,pk1) in
  event PolicyAuthenticated(P2,P1,rho1);
  if hpol(rho1) = hb1 then
  if policySelf(rho1) = P1 then
  event PolicyAccepted(P2,P1,rho1);
  event PolicyAcceptedKeys(P2,P1,pk2,pk1,rho1);
  in(net,(=P3,=P2,msg3: bitstring));
  let policyMsg(=pk2,rho3: policy) = checksign(msg3,pk3) in
  event PolicyAuthenticated(P2,P3,rho3);
  if hpol(rho3) = hb3 then
  if policySelf(rho3) = P3 then
  event PolicyAccepted(P2,P3,rho3);
  event PolicyAcceptedKeys(P2,P3,pk2,pk3,rho3);
  event PoliciesComplete(P2);
  let joined12 = joinstar(constraints(rho1),constraints(rho2)) in
  let pistar = joinstar(joined12,constraints(rho3)) in
  event FullJoin(P2,pistar);
  event ConfirmationSent(P2,P1,hstar(pistar));
  out(net,(P2,P1,sign(confirmMsg(pk1,hstar(pistar)),sk2)));
  event ConfirmationSent(P2,P3,hstar(pistar));
  out(net,(P2,P3,sign(confirmMsg(pk3,hstar(pistar)),sk2)));
  in(net,(=P1,=P2,confirmation1: bitstring));
  let confirmMsg(=pk2,hs1: bitstring) = checksign(confirmation1,pk1) in
  event ConfirmationAuthenticated(P2,P1,hs1);
  if hs1 = hstar(pistar) then
  event ConfirmationAccepted(P2,P1,hs1);
  in(net,(=P3,=P2,confirmation3: bitstring));
  let confirmMsg(=pk2,hs3: bitstring) = checksign(confirmation3,pk3) in
  event ConfirmationAuthenticated(P2,P3,hs3);
  if hs3 = hstar(pistar) then
  event ConfirmationAccepted(P2,P3,hs3);
  event Confirm(P2,pistar).

(* RPE_3: required peers are the fixed Members3 configuration minus self. *)
let rpe3(akR: skey, pkAKR: pkey, pkAKE: pkey) =
  in(net,selectedProfile: profile) [precise];
  let rho3 = choosePolicy(selectedProfile) in
  (* Stage 1 is an initialization premise: Self=P3, authorized policy/key,
   * concrete own signer s3; owner signature verification is not proved here. *)
  new sk3: skey;
  let pk3 = pk(sk3) in
  event PolicyDeclared(P3,rho3);
  let q3 = sign(rpeQuote(mRPE,Good,hbind(pk3,hpol(rho3))),akR) in
  out(net,(P3,q3,pk3,hpol(rho3)));
  in(net,(=P1,q1: bitstring,pk1: pkey,hb1: bitstring));
  let rpeQuote(=mRPE,ts1: tcbstatus,d1: bitstring) = checksign(q1,pkAKR) in
  if d1 = hbind(pk1,hb1) then
  let tcbok1 = matchtcb(rpeTcb1(rho3),ts1) in
  if tcbok1 = true then
  if pk1 <> pk3 then
  event EvidenceChecked(P3,P1,pk1,hb1);
  in(net,(=P2,q2: bitstring,pk2: pkey,hb2: bitstring));
  let rpeQuote(=mRPE,ts2: tcbstatus,d2: bitstring) = checksign(q2,pkAKR) in
  if d2 = hbind(pk2,hb2) then
  let tcbok2 = matchtcb(rpeTcb2(rho3),ts2) in
  if tcbok2 = true then
  if pk2 <> pk3 && pk2 <> pk1 then
  event EvidenceChecked(P3,P2,pk2,hb2);
  event QuotesComplete(P3);
  event PolicySent(P3,pk1,rho3);
  out(net,(P3,P1,sign(policyMsg(pk1,rho3),sk3)));
  event PolicySent(P3,pk2,rho3);
  out(net,(P3,P2,sign(policyMsg(pk2,rho3),sk3)));
  in(net,(=P1,=P3,msg1: bitstring));
  let policyMsg(=pk3,rho1: policy) = checksign(msg1,pk1) in
  event PolicyAuthenticated(P3,P1,rho1);
  if hpol(rho1) = hb1 then
  if policySelf(rho1) = P1 then
  event PolicyAccepted(P3,P1,rho1);
  event PolicyAcceptedKeys(P3,P1,pk3,pk1,rho1);
  in(net,(=P2,=P3,msg2: bitstring));
  let policyMsg(=pk3,rho2: policy) = checksign(msg2,pk2) in
  event PolicyAuthenticated(P3,P2,rho2);
  if hpol(rho2) = hb2 then
  if policySelf(rho2) = P2 then
  event PolicyAccepted(P3,P2,rho2);
  event PolicyAcceptedKeys(P3,P2,pk3,pk2,rho2);
  event PoliciesComplete(P3);
  let joined12 = joinstar(constraints(rho1),constraints(rho2)) in
  let pistar = joinstar(joined12,constraints(rho3)) in
  event FullJoin(P3,pistar);
  event ConfirmationSent(P3,P2,hstar(pistar));
  out(net,(P3,P2,sign(confirmMsg(pk2,hstar(pistar)),sk3)));
  in(net,(=P1,=P3,confirmation1: bitstring));
  let confirmMsg(=pk3,hs1: bitstring) = checksign(confirmation1,pk1) in
  event ConfirmationAuthenticated(P3,P1,hs1);
  if hs1 = hstar(pistar) then
  event ConfirmationAccepted(P3,P1,hs1);
  in(net,(=P2,=P3,confirmation2: bitstring));
  let confirmMsg(=pk3,hs2: bitstring) = checksign(confirmation2,pk2) in
  event ConfirmationAuthenticated(P3,P2,hs2);
  if hs2 = hstar(pistar) then
  event ConfirmationAccepted(P3,P2,hs2);
  event Confirm(P3,pistar).

process
  new akRPE: skey;
  new akTEE: skey;
  new akADV: skey;
  out(net,(pk(akRPE),pk(akTEE),pk(akADV),akADV));
  (rpe1(akRPE,pk(akRPE),pk(akTEE)) |
   rpe2(akRPE,pk(akRPE),pk(akTEE)) |
   rpe3(akRPE,pk(akRPE),pk(akTEE)))
