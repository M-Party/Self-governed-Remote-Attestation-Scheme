   let right = DiagStar2(OnlyGood,OnlyGood,Req(exact(mE1), exact(sBad), exact(prodA), V1, OnlyGood, Assign(P1)),Req(exact(mE2), exact(s2), exact(prodA), V1, OnlyGood, Assign(P2))) in
