      else 0))
  | (* N=2, profile=RejectPeerTCB *)
  (let left = DiagStar2(OnlyGood,OnlyGood,Req(exact(mE1), exact(s1), exact(prodA), V1, OnlyGood, Assign(P1)),Req(exact(mE2), exact(s2), exact(prodA), V1, OnlyGood, Assign(P2))) in
   let right = DiagStar2(OnlyOutdated,OnlyGood,Req(exact(mE1), exact(s1), exact(prodA), V1, OnlyGood, Assign(P1)),Req(exact(mE2), exact(s2), exact(prodA), V1, OnlyGood, Assign(P2))) in
   let generic = genericjoin2(left,right) in
     (let specialized = diagjoin2(left,right) in
       (if specialized = generic then 0 else event WrongSpecializationN2())
      else event WrongSpecializationN2())
   else
     (let specialized = diagjoin2(left,right) in
       event WrongSpecializationN2()
      else 0))
  | (* N=2, profile=NoAssignments *)
  (let left = DiagStar2(OnlyGood,OnlyGood,Req(exact(mE1), exact(s1), exact(prodA), V1, OnlyGood, Assign(P1)),Req(exact(mE2), exact(s2), exact(prodA), V1, OnlyGood, Assign(P2))) in
   let right = DiagStar2(OnlyGood,OnlyGood,Req(exact(mE1), exact(s1), exact(prodA), V1, OnlyGood, NoAtt),Req(exact(mE2), exact(s2), exact(prodA), V1, OnlyGood, Assign(P2))) in
   let generic = genericjoin2(left,right) in
