  (let left = DiagStar2(OnlyGood,OnlyGood,Req(exact(mE1), exact(s1), exact(prodA), V1, OnlyGood, Assign(P1)),Req(exact(mE2), exact(s2), exact(prodA), V1, OnlyGood, Assign(P2))) in
   let right = DiagStar2(OnlyGood,OnlyGood,Req(exact(mE1), exact(s1), exact(prodA), V2, OnlyGood, Assign(P1)),Req(exact(mE2), exact(s2), exact(prodA), V1, OnlyGood, Assign(P2))) in
