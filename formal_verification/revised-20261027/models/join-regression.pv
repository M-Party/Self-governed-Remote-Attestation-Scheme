  | (let got = joinid(exact(mBad), exact(mE1)) in event WrongJoinIdentity() else 0)
  | (let got = joinid(exact(mBad), exact(mE2)) in event WrongJoinIdentity() else 0)
  | (let got = joinid(exact(mBad), exact(mBad)) in (if got = exact(mBad) then 0 else event WrongJoinIdentity()) else event WrongJoinIdentity())
  | (let got = joinv(V0, V0) in (if got = V0 then 0 else event WrongJoinSVN()) else event WrongJoinSVN())
  | (let got = joinv(V0, V1) in (if got = V1 then 0 else event WrongJoinSVN()) else event WrongJoinSVN())
  | (let got = joinv(V0, V2) in (if got = V2 then 0 else event WrongJoinSVN()) else event WrongJoinSVN())
  | (let got = joinv(V1, V0) in (if got = V1 then 0 else event WrongJoinSVN()) else event WrongJoinSVN())
  | (let got = joinv(V1, V1) in (if got = V1 then 0 else event WrongJoinSVN()) else event WrongJoinSVN())
  | (let got = joinv(V1, V2) in (if got = V2 then 0 else event WrongJoinSVN()) else event WrongJoinSVN())
  | (let got = joinv(V2, V0) in (if got = V2 then 0 else event WrongJoinSVN()) else event WrongJoinSVN())
  | (let got = joinv(V2, V1) in (if got = V2 then 0 else event WrongJoinSVN()) else event WrongJoinSVN())
  | (let got = joinv(V2, V2) in (if got = V2 then 0 else event WrongJoinSVN()) else event WrongJoinSVN())
  | (let got = jointcb(Both, Both) in (if got = Both then 0 else event WrongJoinTCB()) else event WrongJoinTCB())
  | (let got = jointcb(Both, OnlyGood) in (if got = OnlyGood then 0 else event WrongJoinTCB()) else event WrongJoinTCB())
  | (let got = jointcb(Both, OnlyOutdated) in (if got = OnlyOutdated then 0 else event WrongJoinTCB()) else event WrongJoinTCB())
  | (let got = jointcb(OnlyGood, Both) in (if got = OnlyGood then 0 else event WrongJoinTCB()) else event WrongJoinTCB())
  | (let got = jointcb(OnlyGood, OnlyGood) in (if got = OnlyGood then 0 else event WrongJoinTCB()) else event WrongJoinTCB())
  | (let got = jointcb(OnlyGood, OnlyOutdated) in event WrongJoinTCB() else 0)
