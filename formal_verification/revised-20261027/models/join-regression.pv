  | (let got = jointcb(OnlyOutdated, OnlyOutdated) in (if got = OnlyOutdated then 0 else event WrongJoinTCB()) else event WrongJoinTCB())
  | (let got = joinatt(NoAtt, NoAtt) in (if got = NoAtt then 0 else event WrongJoinAttester()) else event WrongJoinAttester())
  | (let got = joinatt(NoAtt, Assign(P1)) in (if got = Assign(P1) then 0 else event WrongJoinAttester()) else event WrongJoinAttester())
  | (let got = joinatt(NoAtt, Assign(P2)) in (if got = Assign(P2) then 0 else event WrongJoinAttester()) else event WrongJoinAttester())
  | (let got = joinatt(NoAtt, Assign(P3)) in (if got = Assign(P3) then 0 else event WrongJoinAttester()) else event WrongJoinAttester())
  | (let got = joinatt(Assign(P1), NoAtt) in (if got = Assign(P1) then 0 else event WrongJoinAttester()) else event WrongJoinAttester())
  | (let got = joinatt(Assign(P1), Assign(P1)) in (if got = Assign(P1) then 0 else event WrongJoinAttester()) else event WrongJoinAttester())
  | (let got = joinatt(Assign(P1), Assign(P2)) in event WrongJoinAttester() else 0)
  | (let got = joinatt(Assign(P1), Assign(P3)) in event WrongJoinAttester() else 0)
  | (let got = joinatt(Assign(P2), NoAtt) in (if got = Assign(P2) then 0 else event WrongJoinAttester()) else event WrongJoinAttester())
  | (let got = joinatt(Assign(P2), Assign(P1)) in event WrongJoinAttester() else 0)
  | (let got = joinatt(Assign(P2), Assign(P2)) in (if got = Assign(P2) then 0 else event WrongJoinAttester()) else event WrongJoinAttester())
  | (let got = joinatt(Assign(P2), Assign(P3)) in event WrongJoinAttester() else 0)
  | (let got = joinatt(Assign(P3), NoAtt) in (if got = Assign(P3) then 0 else event WrongJoinAttester()) else event WrongJoinAttester())
  | (let got = joinatt(Assign(P3), Assign(P1)) in event WrongJoinAttester() else 0)
  | (let got = joinatt(Assign(P3), Assign(P2)) in event WrongJoinAttester() else 0)
  | (let got = joinatt(Assign(P3), Assign(P3)) in (if got = Assign(P3) then 0 else event WrongJoinAttester()) else event WrongJoinAttester())
  | (let got = matchid(Any, mE1) in (if got = true then 0 else event WrongMatchIdentity()) else event WrongMatchIdentity())
  | (let got = matchid(Any, mE2) in (if got = true then 0 else event WrongMatchIdentity()) else event WrongMatchIdentity())
  | (let got = matchid(Any, mBad) in (if got = true then 0 else event WrongMatchIdentity()) else event WrongMatchIdentity())
  | (let got = matchid(exact(mE1), mE1) in (if got = true then 0 else event WrongMatchIdentity()) else event WrongMatchIdentity())
  | (let got = matchid(exact(mE1), mE2) in event WrongMatchIdentity() else 0)
  | (let got = matchid(exact(mE1), mBad) in event WrongMatchIdentity() else 0)
  | (let got = matchid(exact(mE2), mE1) in event WrongMatchIdentity() else 0)
  | (let got = matchid(exact(mE2), mE2) in (if got = true then 0 else event WrongMatchIdentity()) else event WrongMatchIdentity())
  | (let got = matchid(exact(mE2), mBad) in event WrongMatchIdentity() else 0)
  | (let got = matchid(exact(mBad), mE1) in event WrongMatchIdentity() else 0)
  | (let got = matchid(exact(mBad), mE2) in event WrongMatchIdentity() else 0)
  | (let got = matchid(exact(mBad), mBad) in (if got = true then 0 else event WrongMatchIdentity()) else event WrongMatchIdentity())
  | (let got = matchv(V0, V0) in (if got = true then 0 else event WrongMatchSVN()) else event WrongMatchSVN())
  | (let got = matchv(V0, V1) in (if got = true then 0 else event WrongMatchSVN()) else event WrongMatchSVN())
  | (let got = matchv(V0, V2) in (if got = true then 0 else event WrongMatchSVN()) else event WrongMatchSVN())
  | (let got = matchv(V1, V0) in event WrongMatchSVN() else 0)
  | (let got = matchv(V1, V1) in (if got = true then 0 else event WrongMatchSVN()) else event WrongMatchSVN())
  | (let got = matchv(V1, V2) in (if got = true then 0 else event WrongMatchSVN()) else event WrongMatchSVN())
  | (let got = matchv(V2, V0) in event WrongMatchSVN() else 0)
  | (let got = matchv(V2, V1) in event WrongMatchSVN() else 0)
  | (let got = matchv(V2, V2) in (if got = true then 0 else event WrongMatchSVN()) else event WrongMatchSVN())
  | (let got = matchtcb(Both, Good) in (if got = true then 0 else event WrongMatchTCB()) else event WrongMatchTCB())
  | (let got = matchtcb(Both, Outdated) in (if got = true then 0 else event WrongMatchTCB()) else event WrongMatchTCB())
  | (let got = matchtcb(Both, Revoked) in event WrongMatchTCB() else 0)
  | (let got = matchtcb(Both, Invalid) in event WrongMatchTCB() else 0)
  | (let got = matchtcb(OnlyGood, Good) in (if got = true then 0 else event WrongMatchTCB()) else event WrongMatchTCB())
  | (let got = matchtcb(OnlyGood, Outdated) in event WrongMatchTCB() else 0)
  | (let got = matchtcb(OnlyGood, Revoked) in event WrongMatchTCB() else 0)
  | (let got = matchtcb(OnlyGood, Invalid) in event WrongMatchTCB() else 0)
  | (let got = matchtcb(OnlyOutdated, Good) in event WrongMatchTCB() else 0)
  | (let got = matchtcb(OnlyOutdated, Outdated) in (if got = true then 0 else event WrongMatchTCB()) else event WrongMatchTCB())
  | (let got = matchtcb(OnlyOutdated, Revoked) in event WrongMatchTCB() else 0)
  | (let got = matchtcb(OnlyOutdated, Invalid) in event WrongMatchTCB() else 0)
  | (let got = matchatt(NoAtt, P1) in event WrongMatchAttester() else 0)
  | (let got = matchatt(NoAtt, P2) in event WrongMatchAttester() else 0)
  | (let got = matchatt(NoAtt, P3) in event WrongMatchAttester() else 0)
  | (let got = matchatt(Assign(P1), P1) in (if got = true then 0 else event WrongMatchAttester()) else event WrongMatchAttester())
  | (let got = matchatt(Assign(P1), P2) in event WrongMatchAttester() else 0)
  | (let got = matchatt(Assign(P1), P3) in event WrongMatchAttester() else 0)
  | (let got = matchatt(Assign(P2), P1) in event WrongMatchAttester() else 0)
  | (let got = matchatt(Assign(P2), P2) in (if got = true then 0 else event WrongMatchAttester()) else event WrongMatchAttester())
  | (let got = matchatt(Assign(P2), P3) in event WrongMatchAttester() else 0)
  | (let got = matchatt(Assign(P3), P1) in event WrongMatchAttester() else 0)
  | (let got = matchatt(Assign(P3), P2) in event WrongMatchAttester() else 0)
  | (let got = matchatt(Assign(P3), P3) in (if got = true then 0 else event WrongMatchAttester()) else event WrongMatchAttester())
  | (let neutral = Req(Any, Any, Any, V0, Both, NoAtt) in
     let c = Req(exact(mE1), exact(s1), exact(prodA), V2, OnlyGood, Assign(P1)) in
     let left = joinentry(neutral, c) in
     let right = joinentry(c, neutral) in
     let idem = joinentry(c, c) in
     if left = c && right = c && idem = c then event WildcardAndIdempotence())
  | (let cA = Req(Any, exact(s1), Any, V0, Both, Assign(P1)) in
     let cB = Req(exact(mE1), exact(s1), exact(prodA), V2, OnlyGood, Assign(P1)) in
     let cC = Req(exact(mE1), exact(s1), Any, V1, Both, Assign(P1)) in
     let twoInputs = joinentry(cA, cB) in
     let threeInputs = joinentry(twoInputs, cC) in
     if cA <> cB && cA <> cC && cB <> cC && twoInputs = threeInputs then event RedundantInputsEqual())
  | (let cA = Req(Any, exact(s1), Any, V0, Both, Assign(P1)) in
     let cB = Req(exact(mE1), exact(s1), Any, V1, Both, Assign(P1)) in
     let ab = joinentry(cA, cB) in
     let ba = joinentry(cB, cA) in
     if ab = ba then event OrderNormalization())
  | (let ok = checkentry(Req(exact(mE1), exact(s1), exact(prodA), V2, OnlyGood, Assign(P1)), P1, Identity(mE1, s1, prodA, V2), Good) in
     if ok = true then event CompatibleEntryAccepted())
  | (let impossible = joinentry(Req(exact(mE1), exact(s1), exact(prodA), V2, OnlyGood, Assign(P1)), Req(exact(mBad), Any, Any, V0, Both, NoAtt)) in event MeasurementConflictAccepted())
  | (let impossible = joinentry(Req(exact(mE1), exact(s1), exact(prodA), V2, OnlyGood, Assign(P1)), Req(Any, exact(sBad), Any, V0, Both, NoAtt)) in event SignerConflictAccepted())
  | (let impossible = joinentry(Req(exact(mE1), exact(s1), exact(prodA), V2, OnlyGood, Assign(P1)), Req(Any, Any, exact(prodB), V0, Both, NoAtt)) in event ProductConflictAccepted())
  | (let impossible = joinentry(Req(exact(mE1), exact(s1), exact(prodA), V2, OnlyGood, Assign(P1)), Req(Any, Any, Any, V0, OnlyOutdated, NoAtt)) in event TCBConflictAccepted())
  | (let impossible = joinentry(Req(exact(mE1), exact(s1), exact(prodA), V2, OnlyGood, Assign(P1)), Req(Any, Any, Any, V0, Both, Assign(P2))) in event AttesterConflictAccepted())
  | (let accepted = checkentry(Req(Any, Any, Any, V0, Both, Assign(P1)), P1, Identity(mE1, s1, prodA, V2), Revoked) in if accepted = true then event RevokedAccepted())
  | (let accepted = checkentry(Req(Any, Any, Any, V0, Both, Assign(P1)), P1, Identity(mE1, s1, prodA, V2), Invalid) in if accepted = true then event InvalidAccepted())
  | (let accepted = checkentry(Req(exact(mE1), exact(s1), exact(prodA), V2, OnlyGood, Assign(P1)), P1, Identity(mBad, s1, prodA, V2), Good) in if accepted = true then event UnexpectedEntryAcceptance())
  | (let accepted = checkentry(Req(exact(mE1), exact(s1), exact(prodA), V2, OnlyGood, Assign(P1)), P1, Identity(mE1, sBad, prodA, V2), Good) in if accepted = true then event UnexpectedEntryAcceptance())
  | (let accepted = checkentry(Req(exact(mE1), exact(s1), exact(prodA), V2, OnlyGood, Assign(P1)), P1, Identity(mE1, s1, prodB, V2), Good) in if accepted = true then event UnexpectedEntryAcceptance())
  | (let accepted = checkentry(Req(exact(mE1), exact(s1), exact(prodA), V2, OnlyGood, Assign(P1)), P1, Identity(mE1, s1, prodA, V1), Good) in if accepted = true then event UnexpectedEntryAcceptance())
  | (let accepted = checkentry(Req(exact(mE1), exact(s1), exact(prodA), V2, OnlyGood, Assign(P1)), P1, Identity(mE1, s1, prodA, V2), Outdated) in if accepted = true then event UnexpectedEntryAcceptance())
  | (let accepted = checkentry(Req(exact(mE1), exact(s1), exact(prodA), V2, OnlyGood, Assign(P1)), P2, Identity(mE1, s1, prodA, V2), Good) in if accepted = true then event UnexpectedEntryAcceptance())
  | (let accepted = checkentry(Req(Any, Any, Any, V0, Both, NoAtt), P1, Identity(mE1, s1, prodA, V2), Good) in if accepted = true then event UnexpectedEntryAcceptance())
