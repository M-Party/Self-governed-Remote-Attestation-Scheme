query event(WrongMatchTCB()).
(* J08: UNREACHABLE; raw not-event result TRUE. *)
query event(WrongMatchAttester()).
(* J09: REACHABLE; raw not-event result FALSE. *)
query event(WildcardAndIdempotence()).
(* J10: REACHABLE; raw not-event result FALSE. *)
query event(RedundantInputsEqual()).
(* J11: REACHABLE; raw not-event result FALSE. *)
query event(OrderNormalization()).
(* J12: REACHABLE; raw not-event result FALSE. *)
query event(CompatibleEntryAccepted()).
(* J13: UNREACHABLE; raw not-event result TRUE. *)
query event(MeasurementConflictAccepted()).
(* J14: UNREACHABLE; raw not-event result TRUE. *)
query event(SignerConflictAccepted()).
(* J15: UNREACHABLE; raw not-event result TRUE. *)
query event(ProductConflictAccepted()).
(* J16: UNREACHABLE; raw not-event result TRUE. *)
query event(TCBConflictAccepted()).
(* J17: UNREACHABLE; raw not-event result TRUE. *)
query event(AttesterConflictAccepted()).
(* J18: UNREACHABLE; raw not-event result TRUE. *)
query event(RevokedAccepted()).
(* J19: UNREACHABLE; raw not-event result TRUE. *)
query event(InvalidAccepted()).
(* J20: UNREACHABLE; raw not-event result TRUE. *)
query event(UnexpectedEntryAcceptance()).

process
  (let got = joinid(Any, Any) in (if got = Any then 0 else event WrongJoinIdentity()) else event WrongJoinIdentity())
  | (let got = joinid(Any, exact(mE1)) in (if got = exact(mE1) then 0 else event WrongJoinIdentity()) else event WrongJoinIdentity())
  | (let got = joinid(Any, exact(mE2)) in (if got = exact(mE2) then 0 else event WrongJoinIdentity()) else event WrongJoinIdentity())
  | (let got = joinid(Any, exact(mBad)) in (if got = exact(mBad) then 0 else event WrongJoinIdentity()) else event WrongJoinIdentity())
  | (let got = joinid(exact(mE1), Any) in (if got = exact(mE1) then 0 else event WrongJoinIdentity()) else event WrongJoinIdentity())
  | (let got = joinid(exact(mE1), exact(mE1)) in (if got = exact(mE1) then 0 else event WrongJoinIdentity()) else event WrongJoinIdentity())
  | (let got = joinid(exact(mE1), exact(mE2)) in event WrongJoinIdentity() else 0)
  | (let got = joinid(exact(mE1), exact(mBad)) in event WrongJoinIdentity() else 0)
  | (let got = joinid(exact(mE2), Any) in (if got = exact(mE2) then 0 else event WrongJoinIdentity()) else event WrongJoinIdentity())
