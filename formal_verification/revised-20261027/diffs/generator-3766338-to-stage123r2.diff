+def nonquery(source):
+    text = re.sub(r'\(\*.*?\*\)', '', source, flags=re.S)
+    text = re.sub(r'^query\b.*?\.', '', text, flags=re.M | re.S)
+    return sha(re.sub(r'\s+', ' ', text).strip().encode())
